[sub_resource type="Resource" id="Resource_50g57"]
script = ExtResource("10_lluy8")
video = ExtResource("11_gw407")
title = "Chainers"
description = "Chainers are massive meelee enemies that act as tanks.
Good news is, their movement is limited.
Bad news is, so is yours."
metadata/_custom_type_script = "uid://duub2ne1m1uaf"

[sub_resource type="Resource" id="Resource_k25s1"]
script = ExtResource("10_lluy8")
video = ExtResource("11_gw407")
title = "Chainers"
description = "They will chain you up, limiting how far away you can move from them, represented as a yellow sphere around them.
The sphere will slowly shrink, but damaging the chainer will expand it."
metadata/_custom_type_script = "uid://duub2ne1m1uaf"

[sub_resource type="Resource" id="Resource_cx5hu"]
script = ExtResource("10_lluy8")
video = ExtResource("11_gw407")
title = "Chainers"
description = "The sphere will act as a wall, meaning you can wall run and jump on it.
Unlike normal walls however, you can also slide on them, which will not let you fall until you stop sliding.
Use this to your advantage!"
metadata/_custom_type_script = "uid://duub2ne1m1uaf"

