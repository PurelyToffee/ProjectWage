[sub_resource type="Resource" id="Resource_pbpqa"]
script = ExtResource("3_4l4x3")
title = "Wall Running"
description = "You can [color=Highlight1]wall run[/color] by moving along a wall and jumping onto it.
While wall running, you won't be able to change your movement direction until you jump, land, or the wall ends."
metadata/_custom_type_script = "uid://duub2ne1m1uaf"

[sub_resource type="Resource" id="Resource_r7i4d"]
script = ExtResource("3_4l4x3")
title = "Wall Running"
description = "When you jump off a wall while wall running, you will jump in the direction you're facing, 
[color=Highlight1]no matter the angle[/color]."
metadata/_custom_type_script = "uid://duub2ne1m1uaf"

